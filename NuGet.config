<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear discards machine- and user-level feeds so restore cannot resolve a dependency
         (including the DPAPI credential library) from an unexpected source. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- disabledPackageSources is keyed by source name and inherited: without this clear, a
       machine-level entry disabling "nuget.org" would also disable the source added above. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
