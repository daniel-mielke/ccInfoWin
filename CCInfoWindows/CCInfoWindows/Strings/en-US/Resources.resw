  <!-- MainView workflow subagent row (v1.7). Windows-only: no macOS counterpart, upstream ccInfo
       has no workflow display and therefore no equivalent key. Full note on
       SubagentContextData.WorkflowId.
       {0} = run id, verbatim, never translated.
       {1} = agents finished, {2} = agents started so far (a growing denominator by design,
       not a planned total), {3} = summed context of the run, already formatted (e.g. "3.3M"). -->
  <data name="WorkflowSubagentLabel" xml:space="preserve">
    <value>{0} · {1}/{2} agents done · {3} tokens</value>
  </data>

  <!-- Same row for a run without journal.jsonl: no agent count exists, so it is left out rather
       than guessed. {0} = run id, {1} = formatted token sum. -->
  <data name="WorkflowSubagentLabelTokensOnly" xml:space="preserve">
    <value>{0} · {1} tokens</value>
  </data>

  <!-- MainView workflow row hover tooltip (v1.7 Phase 4). Windows-only, same note as above.
       One key per line, each carrying the LABEL for its value (D-17): a tooltip is read in
       isolation, so a bare "wf_eda3abc2-8c9" would not say what it is. The VALUES are never
       translated — run id, workflow name and description go into their placeholder verbatim.
       The noun sits BEFORE the number ("Agents: 1/8 done") to sidestep pluralisation, which
       WinUI3Localizer 2.3.0 cannot do.
       WorkflowTooltipContext says "context", never "usage": the number is the summed FINAL
       context of the run's agents, measured 34.6x smaller than what the run actually consumed. -->
  <data name="WorkflowTooltipKind" xml:space="preserve">
    <value>Workflow</value>
  </data>
