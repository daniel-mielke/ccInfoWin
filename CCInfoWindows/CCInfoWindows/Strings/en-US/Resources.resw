  <!-- Phase 27 NEXTWIN-01..03: absolute next-window start label (D-NW-03 / CD-01).
       .NET custom date format string, per locale. One key per language replaces the former
       NextWindowLabelDe/En pair, which the ViewModel picked with a culture.Name.StartsWith("de")
       branch — a two-language assumption in code that gave every third language English's layout. -->
  <data name="NextWindowLabelPattern" xml:space="preserve">
    <value>ddd HH:mm</value>
  </data>

  <!-- Weekly/Sonnet reset date. .NET custom date format string, per locale: an English reader
       parses the German "06.08." as June 8th, so the field order has to change with the language. -->
  <data name="WeeklyResetDatePattern" xml:space="preserve">
    <value>ddd, MMM d, HH:mm</value>
  </data>

  <!-- Workflow run start time in the row tooltip. Same layout as WeeklyResetDatePattern on purpose
       — the app should not carry two date styles. Date included, not just the time: a run started
       yesterday would otherwise read as today's. -->
  <data name="WorkflowTooltipStartPattern" xml:space="preserve">
    <value>ddd, MMM d, HH:mm</value>
