<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>CCInfoWindows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Version>1.6.1</Version>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <Product>CCInfoWindows</Product>
    <Description>Real-time Claude Code usage monitoring for Windows</Description>
    <Copyright>Copyright (c) 2026 Daniel Mielke</Copyright>
    <!-- Trimming and AOT are forbidden: System.Text.Json's reflection path (IL2026) breaks
         JSON deserialization at runtime. Declared here and enforced by the guard target below,
         because a -p: switch on the command line outranks these values. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <!-- Repeated in CCInfoWindows.Tests.csproj: Directory.Build.props sits in CCInfoWindows\,
         which the sibling test project never walks through. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Uncomment to test chart with mock data (disables API polling) -->
    <!-- <DefineConstants>$(DefineConstants);MOCK_CHART</DefineConstants> -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <Target Name="FailOnTrimmedPublish" BeforeTargets="Publish"
          Condition="'$(PublishTrimmed)' == 'true' Or '$(PublishAot)' == 'true'">
    <Error Text="Trimming and AOT are forbidden for CCInfoWindows: the trimmer removes types System.Text.Json needs by reflection (IL2026), which silently blanks the dashboard at runtime. Reverted once already in commit eea7fce. Build the Release exe with: dotnet build CCInfoWindows/CCInfoWindows/CCInfoWindows.csproj -c Release -o CCInfoWindows/CCInfoWindows/bin/x64/Release/net9.0-windows10.0.19041.0/" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260416003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AdysTech.CredentialManager" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="WinUI3Localizer" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\fallback-prices.json" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CCInfoWindows.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Strings\**\*.resw">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy WebView2Loader.dll to output root for unpackaged app -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <PropertyGroup>
      <WebView2LoaderSource>$(OutputPath)runtimes\win-$(Platform)\native\WebView2Loader.dll</WebView2LoaderSource>
      <WebView2LoaderSourceX64>$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll</WebView2LoaderSourceX64>
    </PropertyGroup>
    <Copy SourceFiles="$(WebView2LoaderSource)" DestinationFolder="$(OutputPath)" Condition="Exists('$(WebView2LoaderSource)')" />
    <Copy SourceFiles="$(WebView2LoaderSourceX64)" DestinationFolder="$(OutputPath)" Condition="!Exists('$(WebView2LoaderSource)') And Exists('$(WebView2LoaderSourceX64)')" />
  </Target>
</Project>
