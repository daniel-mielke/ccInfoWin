<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CCInfoWindows.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:viewmodels="using:CCInfoWindows.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:CCInfoWindows.Views"
    xmlns:l="using:WinUI3Localizer"
    mc:Ignorable="d"
    Padding="0">

    <Page.Resources>
        <!-- Spinner rotation storyboard -->
        <Storyboard x:Name="SpinnerStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="RefreshIconTransform"
                Storyboard.TargetProperty="Angle"
                From="0" To="360"
                Duration="0:0:1" />
        </Storyboard>

        <!-- Session list for ComboBox (flat, sorted by activity) -->

        <!-- One labelled line of the workflow tooltip. Defined once and used by both the header and
             the footer list. Two Runs in ONE TextBlock rather than two TextBlocks in a row: a
             description of 82-161 characters has to wrap, and it has to wrap as one sentence
             across the label/value boundary. The label carries its own trailing space. -->
        <DataTemplate x:Key="WorkflowTooltipLineTemplate" x:DataType="viewmodels:WorkflowTooltipLine">
            <!-- FontSize and LineHeight are stated, not inherited. This template is defined in
                 Page.Resources but instantiated inside the card, and relying on the card's implicit
                 TextBlock style to reach it left this line rendering a size apart from the rest. -->
            <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18">
                <Run Text="{x:Bind Label}" Foreground="{ThemeResource SecondaryTextBrush}" />
                <Run Text="{x:Bind Value}" />
            </TextBlock>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}"
          RowDefinitions="Auto,*">

        <!-- Hidden WebView2 for API calls via Chromium fetch() — bypasses Cloudflare -->
        <WebView2
            x:Name="ApiBridgeWebView"
            Visibility="Collapsed"
            Width="0" Height="0" />

        <!-- Row 0: InfoBars (update + session expired) -->
        <StackPanel Grid.Row="0">
            <!-- Update available InfoBar -->
            <InfoBar
                l:Uids.Uid="UpdateInfoBar"
                Severity="Informational"
                IsOpen="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                Message="{x:Bind ViewModel.UpdateMessage, Mode=OneWay}"
                IsClosable="True"
                Closing="OnUpdateInfoBarClosing"
                Margin="0,0,0,4">
                <InfoBar.ActionButton>
                    <Button l:Uids.Uid="UpdateDownloadButton"
                            Command="{x:Bind ViewModel.OpenUpdateDownloadCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Session expired InfoBar -->
            <InfoBar
                l:Uids.Uid="SessionExpiredInfoBar"
                Severity="Warning"
                IsOpen="{x:Bind ViewModel.IsSessionExpired, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSessionExpired, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                IsClosable="False"
                Margin="0,0,0,12">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.ReLoginCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" />
                            <TextBlock l:Uids.Uid="ReLoginButton" />
                        </StackPanel>
                    </Button>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- API error InfoBar. Message comes from the ViewModel, Title from the resw entry -->
            <!-- (single-segment uid: WinUI3Localizer 2.3.0 only resolves Foo.Property keys). -->
            <InfoBar
                l:Uids.Uid="ApiErrorInfoBar"
                Severity="Error"
                Message="{x:Bind ViewModel.ApiErrorMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasApiError, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasApiError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                IsClosable="True"
                Margin="0,0,0,12" />

            <!-- Findings 24 + 25: a failed rename or chart export used to be indistinguishable from -->
            <!-- a successful one. No l:Uids.Uid: the whole text is one localized sentence resolved -->
            <!-- in the ViewModel. IsOpen is TwoWay so dismissing it re-arms the next failure. -->
            <InfoBar
                Severity="Warning"
                Message="{x:Bind ViewModel.ActionErrorMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasActionError, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.HasActionError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                IsClosable="True"
                Margin="0,0,0,12" />

            <!-- PRICING-01..03 / D-PR-02: pricing-service silent-failure InfoBar -->
            <!-- Banner-stack order: auth (highest) → API error → pricing → migration toast -->
            <!-- UID must be single-segment: WinUI3Localizer 2.3.0 only resolves Foo.Property keys (Length==2 split). -->
            <InfoBar
                x:Name="PricingErrorInfoBar"
                l:Uids.Uid="PricingErrorInfoBar"
                Severity="Warning"
                IsOpen="{x:Bind ViewModel.IsPricingErrorVisible, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsPricingErrorVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                IsClosable="False"
                Margin="0,0,0,12" />

            <!-- DROPDOWN-05 / D-04: Session visibility migration toast (one-time, dismissable) -->
            <!-- UID must be single-segment: WinUI3Localizer 2.3.0 only resolves Foo.Property keys (Length==2 split). -->
            <InfoBar
                x:Name="MigrationToastInfoBar"
                l:Uids.Uid="MigrationToastInfoBar"
                Severity="Informational"
                IsOpen="{x:Bind ViewModel.IsSessionVisibilityMigrationToastVisible, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsSessionVisibilityMigrationToastVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                IsClosable="True"
                Closed="OnMigrationToastClosed"
                Margin="0,0,0,12" />
        </StackPanel>

        <!-- Row 1: Dashboard content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="16,12,16,12">

                <!-- ==================== AKTIVE SITZUNG ==================== -->
                <TextBlock l:Uids.Uid="SectionHeaderActiveSession"
                           Style="{StaticResource SectionHeaderTextStyle}" />

                <!-- ==================== SESSION DROPDOWN + RENAME PENCIL ==================== -->
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SessionComboBox"
                              Grid.Column="0"
                              l:Uids.Uid="SessionComboBox"
                              ItemsSource="{x:Bind ViewModel.SortedSessions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              Background="{ThemeResource SegmentedBackgroundBrush}"
                              CornerRadius="8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SessionDisplayItem">
                                <TextBlock Text="{x:Bind DisplayName}"
                                           ToolTipService.ToolTip="{x:Bind TooltipText}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- RENAME-01 / D-03: Pencil button opens ContentDialog.
                         Padding and glyph size are deliberately tighter than IconButtonStyle's:
                         this button lives in a 32px column beside the dropdown, not in the footer. -->
                    <Button x:Name="RenameSessionButton"
                            Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Click="OnRenamePencilClicked"
                            IsEnabled="{x:Bind ViewModel.HasSelectedSession, Mode=OneWay}"
                            Padding="4"
                            Width="32" Height="32"
                            VerticalAlignment="Center">
                        <FontIcon Style="{StaticResource IconGlyphStyle}"
                                  Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                </Grid>

                <!-- Scanning indicator -->
                <TextBlock l:Uids.Uid="ScanningIndicator"
                           FontSize="12"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           HorizontalAlignment="Center"
                           Visibility="{x:Bind ViewModel.IsJsonlScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- "Aktualisiere..." indicator on startup -->
                <TextBlock
                    l:Uids.Uid="UpdatingIndicator"
                    FontSize="12"
                    Foreground="{ThemeResource SecondaryTextBrush}"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsUpdatingFromCache, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Divider below Active Session dropdown -->
                <Border Style="{StaticResource RowDividerStyle}" />

                <!-- ==================== KONTEXTFENSTER ==================== -->
                <StackPanel Spacing="8">
                    <TextBlock l:Uids.Uid="SectionHeaderContextWindow"
                               Style="{StaticResource SectionHeaderTextStyle}" />

                    <!-- Main context progress bar -->
                    <ProgressBar Value="{x:Bind ViewModel.ContextPercentage, Mode=OneWay}"
                                 Maximum="100"
                                 Foreground="{x:Bind ViewModel.ContextUtilizationBrush, Mode=OneWay}"
                                 Background="{ThemeResource ProgressTrackBrush}"
                                 Style="{StaticResource AppProgressBarStyle}" />

                    <!-- Percentage + model badge row -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{x:Bind ViewModel.ContextPercentageText, Mode=OneWay}"
                                   Style="{StaticResource LargePercentageTextStyle}" />
                        <!-- Model badge chip -->
                        <Border Grid.Column="1"
                                Style="{StaticResource ModelBadgeStyle}"
                                HorizontalAlignment="Right"
                                Background="{x:Bind ViewModel.ContextModelBadgeColor, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ContextModelBadge, Mode=OneWay}"
                                       Style="{StaticResource ModelBadgeTextStyle}" />
                        </Border>
                    </Grid>

                    <!-- Autocompact warning -->
                    <TextBlock l:Uids.Uid="AutocompactWarning"
                               FontSize="12"
                               Foreground="{ThemeResource ProgressOrangeBrush}"
                               Visibility="{x:Bind ViewModel.ShowAutocompactWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- No active session placeholder -->
                    <TextBlock l:Uids.Uid="NoActiveSession"
                               FontSize="12"
                               Foreground="{ThemeResource TertiaryTextBrush}"
                               Visibility="{x:Bind ViewModel.HasActiveSession, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                    <!-- Subagent context bars (dynamic) -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.SubagentContexts, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SubagentDisplayData">
                                <!-- Layout: [icon] [Badge] [ProgressBar] [xx%] for a plain subagent,
                                     [icon] [label spanning 1-3] for a workflow run. Both row types
                                     share these four columns, so no DataTemplateSelector.

                                     Windows-only: the workflow row type has no macOS counterpart —
                                     upstream ccInfo renders plain subagents only. See the full note
                                     on SubagentContextData.WorkflowId before aligning this template
                                     with any future upstream design. -->
                                <Grid Margin="0,2,0,0" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Arrow for a single subagent, gear for a workflow run.
                                         FontFamily is pinned: left to DWrite fallback, U+2699
                                         resolves to Segoe UI Emoji, a COLOUR font that ignores
                                         Foreground and rendered the gear as the brightest element
                                         in the row (D-2). Segoe UI Symbol covers both glyphs
                                         monochrome.

                                         SecondaryTextBrush, not Tertiary: measured against
                                         AppBackgroundBrush, Tertiary gives 2.84:1 (dark) and
                                         2.99:1 (light) and so misses the 3:1 of WCAG 1.4.11 for
                                         graphical objects in both themes; Secondary gives 5.22:1
                                         and 4.65:1 (U-21). D-11 only made the glyph honour
                                         Foreground at all — whether that colour carries is a
                                         separate question.

                                         AccessibilityView="Raw" keeps it out of the automation
                                         tree (U-6), where it was announced as a bare "gear" /
                                         "downwards arrow" ahead of the row it decorates. The row
                                         type is already in the label and in the badge. -->
                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Icon}"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="15"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.AccessibilityView="Raw" />

                                    <!-- Model badge (single subagents only) -->
                                    <Border Grid.Column="1"
                                            Style="{StaticResource ModelBadgeStyle}"
                                            Background="{x:Bind BadgeColor}"
                                            HorizontalAlignment="Left"
                                            Visibility="{x:Bind IsWorkflow, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ModelBadge}"
                                                   Style="{StaticResource ModelBadgeTextStyle}" />
                                    </Border>

                                    <!-- Run id + agent progress + summed tokens (workflow rows only).
                                         Composed in the ViewModel: l:Uids.Uid does not reach runtime
                                         template instances. Spans the bar and percentage columns,
                                         which are collapsed for this row type — the star column in
                                         the span absorbs the width, so the trimming has a bound to
                                         work against at any window size. -->
                                    <TextBlock Grid.Column="1" Grid.ColumnSpan="3"
                                               Text="{x:Bind Label}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Tag="{x:Bind}"
                                               IsTabStop="True"
                                               UseSystemFocusVisuals="True"
                                               GotFocus="OnWorkflowRowGotFocus"
                                               LostFocus="OnWorkflowRowLostFocus"
                                               KeyDown="OnWorkflowRowKeyDown"
                                               PointerEntered="OnWorkflowRowPointerEntered"
                                               PointerExited="OnWorkflowRowPointerExited"
                                               PointerCanceled="OnWorkflowRowPointerExited"
                                               Visibility="{x:Bind IsWorkflow, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- The hover content is NOT a ToolTip and does not live here
                                             — see WorkflowTooltipOverlay at the end of this file for
                                             why. The pointer handlers above drive it. They sit on
                                             THIS TextBlock rather than on the Grid because it is
                                             Collapsed on plain rows and receives no pointer events
                                             there: "no hover card for plain rows" needs no converter
                                             and no null check. Trade-off: hovering the gear in
                                             column 0 shows nothing. Accepted.

                                             IsTabStop rides on the same fact: a Collapsed element
                                             is not a tab stop, so plain rows stay out of the tab
                                             order without a converter, and only rows that HAVE a
                                             card can be focused into one. GotFocus and Enter/Space
                                             open it, LostFocus and Escape close it, Left/Right
                                             scroll it —
                                             the card is the only place the run name, description
                                             and phases exist.

                                             Tag carries the whole row rather than just its
                                             Tooltip: the run id on it is what lets the card tell
                                             "my run was retired" from "the list was rebuilt". -->
                                    </TextBlock>

                                    <!-- Progress bar and percentage: plain subagents only. A run has
                                         no single context ceiling to be a percentage OF (43 agents,
                                         43 windows), so the workflow row reports counts and a token
                                         sum instead. -->
                                    <ProgressBar Grid.Column="2"
                                                 Value="{x:Bind Percentage}" Maximum="100"
                                                 Background="{ThemeResource ProgressTrackBrush}"
                                                 Style="{StaticResource AppProgressBarStyle}"
                                                 Margin="6,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{x:Bind IsWorkflow, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind PercentageText}"
                                               FontSize="12"
                                               Margin="6,0,0,0"
                                               Foreground="{ThemeResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Visibility="{x:Bind IsWorkflow, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Divider after Context Window -->
                <Border Style="{StaticResource RowDividerStyle}" />

                <!-- ==================== 5-STUNDEN-FENSTER ==================== -->
                <StackPanel Spacing="8">
                    <!-- Section header with export button -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            l:Uids.Uid="SectionHeaderFiveHour"
                            Style="{StaticResource SectionHeaderTextStyle}"
                            VerticalAlignment="Center" />
                        <Button x:Name="ExportChartButton"
                                Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem l:Uids.Uid="ExportMenuSave"
                                                    Command="{x:Bind ViewModel.ExportChartAsPngCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE792;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem l:Uids.Uid="ExportMenuCopy"
                                                    Command="{x:Bind ViewModel.CopyChartToClipboardCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                            <FontIcon Style="{StaticResource IconGlyphStyle}" Glyph="&#xE898;" />
                        </Button>
                    </Grid>

                    <!-- Area chart replacing ProgressBar -->
                    <Border Background="{ThemeResource ChartBackgroundBrush}"
                            CornerRadius="8" Padding="8" Height="160">
                        <canvas:CanvasControl x:Name="UsageChart"
                                              Draw="UsageChart_Draw"
                                              ClearColor="Transparent" />
                    </Border>

                    <!-- Percentage and countdown row -->
                    <Grid ColumnDefinitions="Auto,*">

                        <!-- Large percentage -->
                        <TextBlock
                            Text="{x:Bind ViewModel.FiveHourPercentageText, Mode=OneWay}"
                            Style="{StaticResource LargePercentageTextStyle}" />

                        <!-- Countdown stack with absolute-time label (NEXTWIN-01..03 / D-NW-01..04) -->
                        <StackPanel Grid.Column="1" Orientation="Vertical"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                            <!-- Existing horizontal countdown stack (preserved verbatim) -->
                            <StackPanel Style="{StaticResource CountdownStackStyle}"
                                        VerticalAlignment="Center">
                                <FontIcon Style="{StaticResource CountdownIconStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.FiveHourCountdown, Mode=OneWay}"
                                    Style="{StaticResource CountdownTextStyle}" />
                            </StackPanel>

                            <!-- NEXTWIN-01..03 / D-NW-01: absolute reset-time below countdown.
                                 11pt/Secondary rather than the weekly sections' 12pt/Tertiary
                                 (QuotaResetDateStyle): this line is the next window's START time,
                                 not a reset date, and it sits under a countdown that already
                                 carries the 13pt Secondary weight. Left as measured — see the
                                 review note on the three quota sections. -->
                            <TextBlock
                                Text="{x:Bind ViewModel.FiveHourNextWindowText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsFiveHourNextWindowVisible, Mode=OneWay,
                                             Converter={StaticResource BoolToVisibilityConverter}}"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Burn rate warning banner -->
                    <Border Background="{ThemeResource BurnRateWarningBrush}"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,8,0,0"
                            Visibility="{x:Bind ViewModel.IsBurnRateWarningVisible, Mode=OneWay,
                                         Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="{x:Bind ViewModel.BurnRateWarningText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xECAD;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="12"
                                      Foreground="White" />
                            <TextBlock Text="{x:Bind ViewModel.BurnRateWarningText, Mode=OneWay}"
                                       Foreground="White"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Divider -->
                <Border Style="{StaticResource RowDividerStyle}" />

                <!-- ==================== WOCHENLIMIT ==================== -->
                <StackPanel Spacing="8">
                    <!-- Section header -->
                    <TextBlock
                        l:Uids.Uid="SectionHeaderWeekly"
                        Style="{StaticResource SectionHeaderTextStyle}" />

                    <!-- Progress bar -->
                    <ProgressBar
                        Value="{x:Bind ViewModel.WeeklyPercentage, Mode=OneWay}"
                        Maximum="100"
                        Foreground="{x:Bind ViewModel.WeeklyUtilizationBrush, Mode=OneWay}"
                        Background="{ThemeResource ProgressTrackBrush}"
                        Style="{StaticResource AppProgressBarStyle}" />

                    <!-- Percentage and countdown/reset row -->
                    <Grid ColumnDefinitions="Auto,*">

                        <!-- Large percentage -->
                        <TextBlock
                            Text="{x:Bind ViewModel.WeeklyPercentageText, Mode=OneWay}"
                            Style="{StaticResource LargePercentageTextStyle}" />

                        <!-- Countdown and reset date -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Spacing="2">
                            <!-- Countdown row -->
                            <StackPanel Style="{StaticResource CountdownStackStyle}">
                                <FontIcon Style="{StaticResource CountdownIconStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.WeeklyCountdown, Mode=OneWay}"
                                    Style="{StaticResource CountdownTextStyle}" />
                            </StackPanel>
                            <!-- Reset date -->
                            <TextBlock
                                Text="{x:Bind ViewModel.WeeklyResetDate, Mode=OneWay}"
                                Style="{StaticResource QuotaResetDateStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Divider (only shown when Sonnet data present) -->
                <Border Style="{StaticResource RowDividerStyle}"
                        Visibility="{x:Bind ViewModel.HasSonnetData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- ==================== SONNET WOCHENLIMIT ==================== -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasSonnetData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Section header -->
                    <TextBlock
                        l:Uids.Uid="SectionHeaderSonnetWeekly"
                        Style="{StaticResource SectionHeaderTextStyle}" />

                    <!-- Progress bar -->
                    <ProgressBar
                        Value="{x:Bind ViewModel.SonnetPercentage, Mode=OneWay}"
                        Maximum="100"
                        Foreground="{x:Bind ViewModel.SonnetUtilizationBrush, Mode=OneWay}"
                        Background="{ThemeResource ProgressTrackBrush}"
                        Style="{StaticResource AppProgressBarStyle}" />

                    <!-- Percentage and countdown/reset row -->
                    <Grid ColumnDefinitions="Auto,*">

                        <!-- Large percentage -->
                        <TextBlock
                            Text="{x:Bind ViewModel.SonnetPercentageText, Mode=OneWay}"
                            Style="{StaticResource LargePercentageTextStyle}" />

                        <!-- Countdown and reset date -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Spacing="2">
                            <!-- Countdown row -->
                            <StackPanel Style="{StaticResource CountdownStackStyle}">
                                <FontIcon Style="{StaticResource CountdownIconStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.SonnetCountdown, Mode=OneWay}"
                                    Style="{StaticResource CountdownTextStyle}" />
                            </StackPanel>
                            <!-- Reset date -->
                            <TextBlock
                                Text="{x:Bind ViewModel.SonnetResetDate, Mode=OneWay}"
                                Style="{StaticResource QuotaResetDateStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Divider before STATISTIKEN -->
                <Border Style="{StaticResource RowDividerStyle}" />

                <!-- ==================== STATISTIKEN ==================== -->
                <StackPanel Spacing="8">
                    <TextBlock l:Uids.Uid="SectionHeaderStats"
                               Style="{StaticResource SectionHeaderTextStyle}" />

                    <!-- Tab Bar -->
                    <controls:Segmented
                        x:Name="StatisticsTabBar"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}"
                        SelectionMode="Single">
                        <!-- Lightweight styling for the toolkit's Segmented control. These four keys
                             have to live in the control's OWN resource scope: they are the names its
                             template looks up, and putting them in AppTheme would repaint the
                             Settings page's tab strip too.

                             SegmentedBackground restates AppTheme's SegmentedBackgroundBrush, which is
                             the source of truth for this surface — SessionComboBox 450 lines above
                             paints from it, and the two are meant to match. The light value used to
                             read #DCDCE0 against AppTheme's #E5E5EA and the two surfaces visibly
                             disagreed; #E5E5EA (macOS systemGray5, also ShimmerBaseBrush) is the one
                             that stayed.

                             ponytail: the literal is duplicated on purpose. Aliasing it with
                             <StaticResource ResourceKey="SegmentedBackgroundBrush" /> from inside a
                             theme dictionary resolves against whichever theme is active when THAT
                             dictionary is realized, and the target lives in a different dictionary's
                             ThemeDictionaries — so the light entry can silently cache the dark brush.
                             Ceiling: keep this in sync with AppTheme by hand. -->
                        <controls:Segmented.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="SegmentedBackground" Color="#38383A" />
                                        <SolidColorBrush x:Key="SegmentedItemBackgroundSelected" Color="#3D5A9E" />
                                        <SolidColorBrush x:Key="SegmentedItemForegroundSelected" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="SegmentedPillBackground" Color="Transparent" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="SegmentedBackground" Color="#E5E5EA" />
                                        <SolidColorBrush x:Key="SegmentedItemBackgroundSelected" Color="#B8D0F5" />
                                        <SolidColorBrush x:Key="SegmentedItemForegroundSelected" Color="#1C1C1E" />
                                        <SolidColorBrush x:Key="SegmentedPillBackground" Color="Transparent" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </controls:Segmented.Resources>
                        <controls:SegmentedItem l:Uids.Uid="TabSession" FontSize="12" />
                        <controls:SegmentedItem l:Uids.Uid="TabToday" FontSize="12" />
                        <controls:SegmentedItem l:Uids.Uid="TabWeek" FontSize="12" />
                        <controls:SegmentedItem l:Uids.Uid="TabMonth" FontSize="12" />
                    </controls:Segmented>

                    <!-- Statistics Data Table.

                         Seven rows of label / value / shimmer placeholder. The value and the
                         placeholder are two views of ONE flag: the value binds through
                         MainView.InvertBool(IsAggregating), the placeholder through
                         BoolToVisibilityConverter on the same property, so exactly one of them is
                         on screen. That pairing is the part that must not drift row to row —
                         geometry and typography now come from StatsRow*/StatsShimmerStyle, so a
                         row carries only its Grid.Row, its uid, its binding and the weight it
                         deliberately differs by.

                         Still hand-built rather than an ItemsRepeater over a ViewModel
                         collection: the seven values are seven separate [ObservableProperty]
                         members and each shimmer Border is reached by x:Name from the code-behind's
                         pulse storyboard. Ceiling: making this data-driven is a ViewModel change,
                         not a markup one. -->
                    <Grid RowSpacing="4"
                          ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Row 0: Modelle -->
                        <TextBlock l:Uids.Uid="StatsModels" Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource StatsRowLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatisticsModels, Mode=OneWay}"
                                   Style="{StaticResource StatsRowValueStyle}"
                                   FontWeight="Normal"
                                   TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Visibility="{x:Bind local:MainView.InvertBool(ViewModel.IsAggregating), Mode=OneWay}" />
                        <Border x:Name="ModelsShimmer"
                                Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource StatsShimmerStyle}"
                                Visibility="{x:Bind ViewModel.IsAggregating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Divider between Models and Input -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2"
                                Style="{StaticResource RowDividerStyle}" Margin="0,2,0,2" />

                        <!-- Row 2: Eingabe -->
                        <TextBlock l:Uids.Uid="StatsInput" Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource StatsRowLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatisticsInput, Mode=OneWay}"
                                   Style="{StaticResource StatsRowValueStyle}"
                                   Visibility="{x:Bind local:MainView.InvertBool(ViewModel.IsAggregating), Mode=OneWay}" />
                        <Border x:Name="InputShimmer"
                                Grid.Row="2" Grid.Column="1"
                                Style="{StaticResource StatsShimmerStyle}"
                                Visibility="{x:Bind ViewModel.IsAggregating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Row 3: Ausgabe -->
                        <TextBlock l:Uids.Uid="StatsOutput" Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource StatsRowLabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatisticsOutput, Mode=OneWay}"
                                   Style="{StaticResource StatsRowValueStyle}"
                                   Visibility="{x:Bind local:MainView.InvertBool(ViewModel.IsAggregating), Mode=OneWay}" />
                        <Border x:Name="OutputShimmer"
                                Grid.Row="3" Grid.Column="1"
                                Style="{StaticResource StatsShimmerStyle}"
                                Visibility="{x:Bind ViewModel.IsAggregating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Row 4: Cache-Schreiben -->
                        <TextBlock l:Uids.Uid="StatsCacheWrite" Grid.Row="4" Grid.Column="0"
                                   Style="{StaticResource StatsRowLabelStyle}" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatisticsCacheCreation, Mode=OneWay}"
                                   Style="{StaticResource StatsRowValueStyle}"
                                   Visibility="{x:Bind local:MainView.InvertBool(ViewModel.IsAggregating), Mode=OneWay}" />
                        <Border x:Name="CacheWriteShimmer"
                                Grid.Row="4" Grid.Column="1"
                                Style="{StaticResource StatsShimmerStyle}"
                                Visibility="{x:Bind ViewModel.IsAggregating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Row 5: Cache-Lesen -->
                        <TextBlock l:Uids.Uid="StatsCacheRead" Grid.Row="5" Grid.Column="0"
                                   Style="{StaticResource StatsRowLabelStyle}" />
                        <TextBlock Grid.Row="5" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatisticsCacheRead, Mode=OneWay}"
                                   Style="{StaticResource StatsRowValueStyle}"
                                   Visibility="{x:Bind local:MainView.InvertBool(ViewModel.IsAggregating), Mode=OneWay}" />
                        <Border x:Name="CacheReadShimmer"
                                Grid.Row="5" Grid.Column="1"
                                Style="{StaticResource StatsShimmerStyle}"
                                Visibility="{x:Bind ViewModel.IsAggregating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Row 6: Divider -->
                        <Border Grid.Row="6" Grid.ColumnSpan="2"
                                Style="{StaticResource RowDividerStyle}" Margin="0,4,0,4" />

                        <!-- Row 7: Gesamt — label and value both SemiBold -->
                        <TextBlock l:Uids.Uid="StatsTotal" Grid.Row="7" Grid.Column="0"
                                   Style="{StaticResource StatsRowLabelStyle}"
                                   FontWeight="SemiBold" />
                        <TextBlock Grid.Row="7" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatisticsTotal, Mode=OneWay}"
                                   Style="{StaticResource StatsRowValueStyle}"
                                   FontWeight="SemiBold"
                                   Visibility="{x:Bind local:MainView.InvertBool(ViewModel.IsAggregating), Mode=OneWay}" />
                        <Border x:Name="TotalShimmer"
                                Grid.Row="7" Grid.Column="1"
                                Style="{StaticResource StatsShimmerStyle}"
                                Visibility="{x:Bind ViewModel.IsAggregating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!-- Row 8: Kosten — value bold, label deliberately not -->
                        <TextBlock l:Uids.Uid="StatsCost" Grid.Row="8" Grid.Column="0"
                                   Style="{StaticResource StatsRowLabelStyle}" />
                        <TextBlock Grid.Row="8" Grid.Column="1"
                                   Text="{x:Bind ViewModel.StatisticsCost, Mode=OneWay}"
                                   Style="{StaticResource StatsRowValueStyle}"
                                   FontWeight="SemiBold"
                                   Visibility="{x:Bind local:MainView.InvertBool(ViewModel.IsAggregating), Mode=OneWay}" />
                        <Border x:Name="CostShimmer"
                                Grid.Row="8" Grid.Column="1"
                                Style="{StaticResource StatsShimmerStyle}"
                                Visibility="{x:Bind ViewModel.IsAggregating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </Grid>
                </StackPanel>

                <!-- Divider above footer -->
                <Border Style="{StaticResource RowDividerStyle}" Margin="0,4,0,0" />

                <!-- Footer toolbar -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" Spacing="16"
                            Padding="0,8,0,4">

                    <!-- Refresh button with spinning icon -->
                    <Grid>
                        <Button x:Name="FooterRefreshButton"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}">
                            <FontIcon x:Name="RefreshIcon"
                                      Style="{StaticResource IconGlyphStyle}"
                                      Glyph="&#xE895;"
                                      RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <RotateTransform x:Name="RefreshIconTransform" Angle="0" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>

                        <!-- API error warning badge -->
                        <Ellipse Width="8" Height="8"
                                 Fill="{ThemeResource ProgressOrangeBrush}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,2,2,0"
                                 Visibility="{x:Bind ViewModel.HasApiError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <!-- Settings button -->
                    <Button x:Name="FooterSettingsButton"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.OpenSettingsCommand}">
                        <FontIcon Style="{StaticResource IconGlyphStyle}" Glyph="&#xE713;" />
                    </Button>

                    <!-- Quit button -->
                    <Button x:Name="FooterQuitButton"
                            Style="{StaticResource IconButtonStyle}"
                            Command="{x:Bind ViewModel.ExitAppCommand}">
                        <FontIcon Style="{StaticResource IconGlyphStyle}" Glyph="&#xE7E8;" />
                    </Button>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ==========================================================================
             Workflow hover card.

             Windows-only, like the rest of the workflow display. Full note on
             SubagentContextData.WorkflowId.

             NOT a ToolTip. ToolTipService cannot express any of what this has to do:
               - a ToolTip anchors to its target element, so "below the hovered row" and
                 "always at the same x relative to the WINDOW" are two different anchors
                 and it can only honour one;
               - its popup is free to leave the window, which is exactly what it did —
                 it opened upward and hung off the top edge of the app;
               - its content cannot scroll, so a window narrower than the card has no
                 way to reach the clipped part.

             Living in the page's own visual tree instead solves all three by
             construction: the Canvas is clipped to the window, x is a constant, and y
             is computed per row in the code-behind.

             Last child of the root Grid and spanning both rows, so it paints above
             everything. The Canvas has no Background, which keeps it hit-transparent
             everywhere except over the card itself — the card stays interactive (the
             scrollbar has to be usable) without swallowing clicks on the page. -->
        <Canvas x:Name="TooltipLayer" Grid.Row="0" Grid.RowSpan="2">
            <Border x:Name="WorkflowTooltipOverlay"
                    Visibility="Collapsed"
                    Canvas.Left="10"
                    Background="{ThemeResource ToolTipBackgroundBrush}"
                    BorderBrush="{ThemeResource PrimaryTextBrush}"
                    BorderThickness="2"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="14,12,14,10"
                    SizeChanged="OnWorkflowTooltipSizeChanged"
                    PointerExited="OnWorkflowTooltipPointerExited">
                <!-- The content's Width is set in the code-behind, never here, and it is
                     an explicit Width rather than a MinWidth. A ScrollViewer offers its
                     child INFINITE width, and an infinitely wide TextBlock never wraps:
                     with only a MinWidth the description rendered as one endless line,
                     and — because the child was then measured at one line's height and
                     arranged at several — the card was also clipped along its bottom
                     edge. Pinning the width removes both at once. -->
                <Grid RowDefinitions="*,Auto">
                <ScrollViewer x:Name="WorkflowTooltipScroll"
                              Grid.Row="0"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled"
                              ViewChanged="OnWorkflowTooltipViewChanged">
                    <StackPanel x:Name="WorkflowTooltipContent">
                        <!-- One list, not a header and a footer with a gap between them:
                             every fact line gets the same air as its neighbours. -->
                        <ItemsControl ItemsSource="{Binding Lines}"
                                      ItemTemplate="{StaticResource WorkflowTooltipLineTemplate}" />

                        <!-- Phase table, last block. A Grid per row rather than a text
                             list: TextWrapping has no hanging indent, so a wrapped
                             detail in a text list falls back to the left margin and the
                             structure collapses. The title column is a fixed width
                             because WinUI has no SharedSizeGroup — a longer title wraps
                             inside its column instead of pushing the details out of
                             alignment. -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasPhases, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding PhasesCaption}"
                                       FontSize="12" LineHeight="18"
                                       Foreground="{ThemeResource SecondaryTextBrush}" />
                            <ItemsControl ItemsSource="{Binding Phases}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:WorkflowPhaseRow">
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind Title}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12" LineHeight="18"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Detail}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12" LineHeight="18"
                                                       Foreground="{ThemeResource SecondaryTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Hand-built scrollbar, because Windows hides the real one.
                         ScrollBarVisibility="Visible" does NOT mean visible: the OS
                         setting Control Panel\Accessibility\DynamicScrollbars defaults
                         to auto-hide, and WinUI honours it by animating the bar's
                         opacity to zero until the pointer interacts with the
                         ScrollViewer. Verified through UIA on the real window — the
                         Horizontal ScrollBar element was present and enabled with a
                         zero-sized rectangle. An app cannot opt out of that setting,
                         and overriding it means replacing the whole ScrollBar
                         ControlTemplate. This track is smaller than that override and
                         does the one thing asked for: it is always there while there is
                         something to scroll. -->
                    <Border x:Name="TooltipScrollTrack"
                            Grid.Row="1"
                            Height="8"
                            CornerRadius="4"
                            Margin="0,8,0,0"
                            Visibility="Collapsed"
                            Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                            PointerPressed="OnTooltipScrollTrackPointerPressed"
                            PointerMoved="OnTooltipScrollTrackPointerMoved"
                            PointerReleased="OnTooltipScrollTrackPointerReleased"
                            PointerCaptureLost="OnTooltipScrollTrackPointerReleased">
                        <Border x:Name="TooltipScrollThumb"
                                HorizontalAlignment="Left"
                                CornerRadius="4"
                                Background="{ThemeResource TertiaryTextBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Canvas>

    </Grid>
</Page>
