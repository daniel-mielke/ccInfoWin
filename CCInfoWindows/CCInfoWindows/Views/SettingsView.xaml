<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CCInfoWindows.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:l="using:WinUI3Localizer"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:CCInfoWindows.Models"
    mc:Ignorable="d"
    Unloaded="OnUnloaded">

    <Page.Resources>
        <!-- ORGID-01 visual-fix: declarative item template for the OrgPicker ContentDialog ListView.
             Replaces the previous code-behind ContainerContentChanging pattern, which rendered items
             invisibly because Content was set in Phase 0 with e.Handled=true — the layout pass ran
             before the TextBlocks entered the visual tree. Declarative DataTemplate participates in
             the normal item-realization lifecycle and inherits ThemeResources correctly inside the
             ContentDialog popup subtree. -->
        <DataTemplate x:Key="OrgPickerItemTemplate" x:DataType="models:OrganizationInfo">
            <StackPanel Margin="4,8,4,8" Spacing="2">
                <TextBlock Text="{x:Bind Name}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock Text="{x:Bind Uuid}"
                           FontSize="11"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="SettingsRootGrid" Background="{ThemeResource AppBackgroundBrush}" Padding="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header — back button + title -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button l:Uids.Uid="SettingsBackButton"
                    Style="{StaticResource IconButtonStyle}"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Padding="4">
                <FontIcon Style="{StaticResource IconGlyphStyle}"
                          Glyph="&#xE72B;"
                          Foreground="{ThemeResource PrimaryTextBrush}" />
            </Button>
            <TextBlock l:Uids.Uid="SettingsHeader"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Row 1: page-level failure surface — language switch and session-name persistence report
             here instead of failing silently. Message text is resolved in the ViewModel. -->
        <InfoBar Grid.Row="1"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.IsErrorVisible, Mode=TwoWay}"
                 Visibility="{x:Bind ViewModel.IsErrorVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 IsClosable="True"
                 Margin="0,0,0,8" />

        <!-- Row 2: Segmented Control — 5 tabs with colored icon badges -->
        <controls:Segmented Grid.Row="2"
            x:Name="TabsSegmented"
            HorizontalAlignment="Stretch"
            Margin="0,0,0,12"
            SelectionChanged="OnSegmentedSelectionChanged"
            SelectedIndex="{x:Bind ViewModel.SelectedTabIndex, Mode=TwoWay}">

            <!-- General tab (green badge) -->
            <controls:SegmentedItem x:Name="TabGeneral">
                <controls:SegmentedItem.Content>
                    <Border Style="{StaticResource SettingsTabBadgeStyle}"
                            Background="{ThemeResource SettingsBadgeGreenBrush}">
                        <FontIcon Style="{StaticResource SettingsTabBadgeGlyphStyle}" Glyph="&#xE713;" />
                    </Border>
                </controls:SegmentedItem.Content>
            </controls:SegmentedItem>

            <!-- Updates tab (blue badge) -->
            <controls:SegmentedItem x:Name="TabUpdates">
                <controls:SegmentedItem.Content>
                    <Border Style="{StaticResource SettingsTabBadgeStyle}"
                            Background="{ThemeResource SettingsBadgeBlueBrush}">
                        <FontIcon Style="{StaticResource SettingsTabBadgeGlyphStyle}" Glyph="&#xE895;" />
                    </Border>
                </controls:SegmentedItem.Content>
            </controls:SegmentedItem>

            <!-- Account tab (red badge) -->
            <controls:SegmentedItem x:Name="TabAccount">
                <controls:SegmentedItem.Content>
                    <Border Style="{StaticResource SettingsTabBadgeStyle}"
                            Background="{ThemeResource SettingsBadgeRedBrush}">
                        <FontIcon Style="{StaticResource SettingsTabBadgeGlyphStyle}" Glyph="&#xE77B;" />
                    </Border>
                </controls:SegmentedItem.Content>
            </controls:SegmentedItem>

            <!-- Sessions tab (purple badge) — Phase 26 / RENAME-02 -->
            <controls:SegmentedItem x:Name="TabSessions">
                <controls:SegmentedItem.Content>
                    <Border Style="{StaticResource SettingsTabBadgeStyle}"
                            Background="{ThemeResource SettingsBadgePurpleBrush}">
                        <FontIcon Style="{StaticResource SettingsTabBadgeGlyphStyle}" Glyph="&#xE70F;" />
                    </Border>
                </controls:SegmentedItem.Content>
            </controls:SegmentedItem>

            <!-- About tab (orange badge) -->
            <controls:SegmentedItem x:Name="TabAbout">
                <controls:SegmentedItem.Content>
                    <Border Style="{StaticResource SettingsTabBadgeStyle}"
                            Background="{ThemeResource SettingsBadgeOrangeBrush}">
                        <FontIcon Style="{StaticResource SettingsTabBadgeGlyphStyle}" Glyph="&#xE946;" />
                    </Border>
                </controls:SegmentedItem.Content>
            </controls:SegmentedItem>

        </controls:Segmented>

        <!-- Row 3: Tab content panels in ScrollViewer -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- PANEL 1 — General Tab -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsGeneralTabVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock l:Uids.Uid="SettingsGeneralHeader"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               Margin="0,0,0,8" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>

                            <!-- Row 1: Autostart -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsAutostartLabel"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ToggleSwitch Grid.Column="1"
                                             l:Uids.Uid="AutostartToggle"
                                             IsOn="{x:Bind ViewModel.IsAutostart, Mode=TwoWay}"
                                             MinWidth="0" OnContent="" OffContent=""
                                             VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 2: Refresh Interval -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsRefreshInterval"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                          l:Uids.Uid="RefreshIntervalComboBox"
                                          ItemsSource="{x:Bind ViewModel.RefreshOptions}"
                                          SelectedItem="{x:Bind ViewModel.SelectedRefreshOption, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 3: Session Timeout -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsSessionTimeout"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                          x:Name="SessionTimeoutComboBox"
                                          l:Uids.Uid="SessionTimeoutComboBox"
                                          ItemsSource="{x:Bind ViewModel.SessionTimeoutOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedIndex="{x:Bind ViewModel.SelectedThresholdIndex, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 3.5: Session Visibility Window (DROPDOWN-04 / D-03) -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsSessionVisibilityWindow"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                          x:Name="VisibilityWindowComboBox"
                                          l:Uids.Uid="VisibilityWindowComboBox"
                                          ItemsSource="{x:Bind ViewModel.VisibilityWindowOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedIndex="{x:Bind ViewModel.SelectedVisibilityWindowIndex, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          MinWidth="120" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 4: Dark Mode -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsDarkMode"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ToggleSwitch Grid.Column="1"
                                             l:Uids.Uid="DarkModeToggle"
                                             IsOn="{x:Bind ViewModel.IsDarkMode, Mode=TwoWay}"
                                             MinWidth="0" OnContent="" OffContent=""
                                             VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 5: Language -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsLanguageLabel"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                          l:Uids.Uid="LanguageComboBox"
                                          Width="120"
                                          SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="Deutsch" />
                                    <ComboBoxItem Content="English" />
                                </ComboBox>
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 6: Reset Window Size -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsResetWindowSizeLabel"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <Button Grid.Column="1"
                                        l:Uids.Uid="SettingsResetWindowSizeButton"
                                        Command="{x:Bind ViewModel.ResetWindowSizeCommand}"
                                        VerticalAlignment="Center" />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PANEL 2 — Updates Tab -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsUpdatesTabVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock l:Uids.Uid="SettingsUpdatesHeader"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               Margin="0,0,0,8" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>

                            <!-- Row 1: App Version -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsAppVersion"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.AppVersionText}"
                                           Style="{StaticResource SettingsRowValueStyle}" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 2: Pricing Source -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsPricingSourceLabel"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.PricingSourceText}"
                                           Style="{StaticResource SettingsRowValueStyle}" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 3: Last Pricing Fetch -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsLastFetchLabel"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.LastFetchRelativeTime, Mode=OneWay}"
                                           Style="{StaticResource SettingsRowValueStyle}" />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PANEL 3 — Account Tab -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsAccountTabVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock l:Uids.Uid="SettingsAccountHeader"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               Margin="0,0,0,8" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>

                            <!-- Row 1: Token Status -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsTokenStatus"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock l:Uids.Uid="SettingsTokenValid"
                                               FontSize="13" Foreground="{ThemeResource ProgressGreenBrush}"
                                               Visibility="{x:Bind ViewModel.IsTokenValid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock l:Uids.Uid="SettingsTokenInvalid"
                                               FontSize="13" Foreground="{ThemeResource ProgressRedBrush}"
                                               Visibility="{x:Bind ViewModel.IsTokenValid, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 2: Logout Button -->
                            <Button Command="{x:Bind ViewModel.LogoutCommand}"
                                    HorizontalAlignment="Stretch"
                                    Background="{ThemeResource ProgressRedBrush}"
                                    Foreground="White"
                                    Margin="12,8,12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF3B1;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="White" />
                                    <TextBlock l:Uids.Uid="SettingsLogoutButton" Foreground="White" />
                                </StackPanel>
                            </Button>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- ORGID-01 / D-OG-02: Re-detect organization button -->
                            <Button x:Name="RedetectOrgButton"
                                    Command="{x:Bind ViewModel.OpenOrgPickerCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="12,8,12,12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock l:Uids.Uid="SettingsAccountRedetectButton" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PANEL 4 — Sessions Tab — Phase 26 / RENAME-02 -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsSessionsTabVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock l:Uids.Uid="SettingsSessionsHeader"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               Margin="0,0,0,8" />

                    <!-- Empty-state placeholder -->
                    <TextBlock l:Uids.Uid="SettingsSessionsNoSessions"
                               FontSize="13"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               Visibility="{x:Bind ViewModel.SessionRenameItems.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibilityConverter}}" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SessionRenameItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionRenameItem">
                                    <Grid Padding="12,6"
                                          ColumnSpacing="8"
                                          Opacity="{x:Bind IsOrphan, Converter={StaticResource OrphanOpacityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Session default name -->
                                        <TextBlock Grid.Column="0" Grid.Row="0"
                                                   Text="{x:Bind DefaultName}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <!-- Orphan subtitle (visible only when IsOrphan == true) -->
                                        <TextBlock Grid.Column="0" Grid.Row="1"
                                                   l:Uids.Uid="SettingsSessionsOrphanLabel"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TertiaryTextBrush}"
                                                   Visibility="{x:Bind IsOrphan, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <!-- Custom name TextBox — commits on LostFocus or Enter.
                                             UpdateSourceTrigger is load-bearing: x:Bind writes
                                             TextBox.Text back on LostFocus by default, which runs
                                             AFTER the LostFocus/Enter handlers, so the command read
                                             the previous (usually empty) value and cleared the name
                                             the user had just typed. -->
                                        <TextBox Grid.Column="1" Grid.RowSpan="2"
                                                 Text="{x:Bind CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="100"
                                                 LostFocus="OnSessionRenameTextBoxLostFocus"
                                                 KeyDown="OnSessionRenameTextBoxKeyDown"
                                                 Tag="{x:Bind}"
                                                 VerticalAlignment="Center" />

                                        <!-- Clear button. Command and label are projected onto the row
                                             by the ViewModel: a DataTemplate opens its own namescope,
                                             so {Binding ElementName=…} cannot see page-level elements
                                             and x:Bind cannot see the page. The glyph is the button's
                                             only content, so the label is also its automation name. -->
                                        <Button Grid.Column="2" Grid.RowSpan="2"
                                                Command="{x:Bind ClearCustomNameCommand}"
                                                CommandParameter="{x:Bind}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind ClearCustomNameLabel}"
                                                ToolTipService.ToolTip="{x:Bind ClearCustomNameLabel}">
                                            <FontIcon Glyph="&#xE894;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- PANEL 5 — About Tab -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.IsAboutTabVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock l:Uids.Uid="SettingsAboutHeader"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               Margin="0,0,0,8" />

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>

                            <!-- Row 1: App Name -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <TextBlock l:Uids.Uid="SettingsAboutAppName"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{ThemeResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 2: Version -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}" ColumnDefinitions="*,Auto">
                                <TextBlock l:Uids.Uid="SettingsVersion"
                                           Style="{StaticResource SettingsRowLabelStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.AppVersionText}"
                                           Style="{StaticResource SettingsRowValueStyle}" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 3: GitHub Link -->
                            <Grid Style="{StaticResource SettingsRowGridStyle}">
                                <HyperlinkButton NavigateUri="https://github.com/stefanlange/ccInfo"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Padding="0">
                                    <TextBlock l:Uids.Uid="SettingsAboutGitHubLink" FontSize="13" />
                                </HyperlinkButton>
                            </Grid>

                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <!-- Row 4: Credits — deliberately NOT SettingsRowGridStyle: the text wraps,
                                 so this row needs MinHeight where every other row has a fixed 40. -->
                            <Grid MinHeight="40" Padding="12,8">
                                <TextBlock l:Uids.Uid="SettingsAboutCredits"
                                           FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>

                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

    </Grid>


</Page>
